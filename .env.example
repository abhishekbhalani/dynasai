PUBLIC_SITE_URL=https://dynasai.ai
PUBLIC_APP_URL=https://app.dynasai.ai
PUBLIC_GTM_ID=GTM-KDPPRVV2
# GA4 only — must look like G-XXXXXXXX (not GTM-...)
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_CONTACT_EMAIL=hello@dynasai.ai

# Playbook OTP (Cloudflare Worker)
# Create KV: npx wrangler kv namespace create LEADS
# Enable sending: npx wrangler email sending enable dynasai.ai
# Then put the KV id into wrangler.jsonc kv_namespaces[0].id
PLAYBOOK_FROM=hello@dynasai.ai
LEAD_NOTIFY=hello@dynasai.ai

# Cloudflare deploy (wrangler + GitHub Actions) — never commit real values
# Create token: https://dash.cloudflare.com/profile/api-tokens
# Template: "Edit Cloudflare Workers" OR Account → Workers Scripts → Edit
# Also add Account Settings → Read if `wrangler whoami` fails in CI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Push the two Cloudflare values into GitHub secrets/variables:
#   npm run cicd:github
#
# GitHub → Settings → Secrets and variables → Actions
# Secrets:
#   CLOUDFLARE_API_TOKEN
#   CLOUDFLARE_ACCOUNT_ID
# Zone ID is in wrangler.jsonc routes[].zone_id (dynasai.ai)
# Variables:
#   PUBLIC_SITE_URL=https://dynasai.ai
#   PUBLIC_APP_URL=https://app.dynasai.ai
#   PUBLIC_GTM_ID=GTM-KDPPRVV2
#   PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
#   PUBLIC_CONTACT_EMAIL=hello@dynasai.ai
#   CLOUDFLARE_WORKER_NAME=dynasai-web
#   CLOUDFLARE_PAGES_PROJECT=dynasai
#   PRODUCTION_HOSTNAME=dynasai.ai
