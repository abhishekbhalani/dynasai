PUBLIC_SITE_URL=https://dynasai.ai
PUBLIC_APP_URL=https://app.dynasai.ai
PUBLIC_GTM_ID=GTM-KDPPRVV2
PUBLIC_CONTACT_EMAIL=hello@dynasai.ai

# Playbook OTP (Cloudflare Worker)
# Create KV: npx wrangler kv namespace create LEADS
# Enable sending: npx wrangler email sending enable dynasai.ai
# Then put the KV id into wrangler.jsonc kv_namespaces[0].id
PLAYBOOK_FROM=hello@dynasai.ai
LEAD_NOTIFY=hello@dynasai.ai

# Cloudflare deploy (wrangler) — never commit real values
# Create token: https://dash.cloudflare.com/profile/api-tokens
# Template: "Edit Cloudflare Workers" OR Account → Workers Scripts → Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
