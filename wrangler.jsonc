{
  "name": "dynasai-web",
  "account_id": "67547d9fd5363024d30f53c31487cf48",
  "main": "workers/site.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "dynasai.ai",
      "zone_id": "deba22f5a6c2a3a60082565beb8f2968",
      "custom_domain": true
    },
    {
      "pattern": "www.dynasai.ai",
      "zone_id": "deba22f5a6c2a3a60082565beb8f2968",
      "custom_domain": true
    },
    {
      "pattern": "admin.dynasai.ai",
      "zone_id": "deba22f5a6c2a3a60082565beb8f2968",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PLAYBOOK_FROM": "hello@dynasai.ai",
    "LEAD_NOTIFY": "hello@dynasai.ai",
    "CHAT_MODEL": "@cf/meta/llama-3.2-3b-instruct",
    "ADMIN_HOST": "admin.dynasai.ai"
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "kv_namespaces": [
    {
      "binding": "LEADS",
      "id": "3b73d03580214ee4b95cd231d42bc59e"
    }
  ]
}
