---
import { site } from '../config';

interface Props {
  variant?: 'header' | 'footer';
}

const { variant = 'header' } = Astro.props;
const markSrc = site.logoMark;
const showTagline = variant === 'header';
---

<a class={`brand brand--${variant}`} href="/" aria-label={`${site.name} home`}>
  <img
    class="brand-mark"
    src={markSrc}
    alt=""
    width="130"
    height="36"
    decoding="async"
    loading={variant === 'header' ? 'eager' : 'lazy'}
    fetchpriority={variant === 'header' ? 'high' : 'auto'}
  />
  {showTagline && (
    <span class="brand-tagline" aria-hidden="true">
      {site.tagline}
    </span>
  )}
</a>
