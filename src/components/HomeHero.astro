---
import { site } from '../config';
import { homeHero } from '../content/site-content';

const { badge, headline, highlight, lede, stats, secondaryCta, tertiaryCta } = homeHero;
---

<section class="home-hero bg-grid-pattern" aria-labelledby="home-hero-heading">
  <div class="container home-hero-inner">
    <div class="home-hero-copy">
      <p class="hero-badge">{badge}</p>
      <h1 id="home-hero-heading">
        {headline} <span class="gradient-text">{highlight}</span>
      </h1>
      <p class="lede">{lede}</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href={site.appUrl}>Start Building</a>
        <a class="btn btn-secondary btn-lg" href={secondaryCta.href}>{secondaryCta.label}</a>
      </div>
      <a class="home-hero-link" href={tertiaryCta.href}>{tertiaryCta.label} →</a>
      <dl class="home-hero-stats">
        {
          stats.map((stat) => (
            <div class="home-hero-stat">
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="home-hero-visual" aria-hidden="true">
      <div class="home-hero-panel home-hero-panel--back">
        <span class="home-hero-panel-label">Value chain</span>
        <ul class="home-hero-flow">
          <li>Underwriting</li>
          <li>Claims</li>
          <li>Service</li>
        </ul>
      </div>
      <div class="home-hero-panel home-hero-panel--main">
        <div class="home-hero-panel-head">
          <span class="home-hero-dot home-hero-dot--live"></span>
          <span>Agent orchestration</span>
        </div>
        <div class="home-hero-metrics">
          <div class="home-hero-metric">
            <strong>Prefill rate</strong>
            <span>87%</span>
          </div>
          <div class="home-hero-metric">
            <strong>Cycle time</strong>
            <span>-42%</span>
          </div>
          <div class="home-hero-metric">
            <strong>Eval score</strong>
            <span>94</span>
          </div>
        </div>
        <div class="home-hero-chart">
          <span class="home-hero-bar home-hero-bar--1"></span>
          <span class="home-hero-bar home-hero-bar--2"></span>
          <span class="home-hero-bar home-hero-bar--3"></span>
          <span class="home-hero-bar home-hero-bar--4"></span>
          <span class="home-hero-bar home-hero-bar--5"></span>
          <span class="home-hero-bar home-hero-bar--6"></span>
        </div>
      </div>
      <div class="home-hero-panel home-hero-panel--float">
        <span aria-hidden="true">◎</span>
        <div>
          <strong>Governed agents</strong>
          <p>Human-in-the-loop · Audit-ready traces</p>
        </div>
      </div>
    </div>
  </div>
</section>
