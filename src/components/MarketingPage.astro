---
import Breadcrumb from './Breadcrumb.astro';
import Icon from './Icon.astro';
import BrandLogo from './BrandLogo.astro';
import { iconForTitle } from '../lib/icon-map';
import { site, isAppHref } from '../config';
import type { MarketingPage as MarketingPageType } from '../content/stitch-pages';

interface Props {
  page: MarketingPageType;
}

const { page } = Astro.props;

const brandLogos = new Set(['aws', 'azure', 'gcp', 'microsoft']);
---

<section class="industry-hero bg-grid-pattern">
  <div class="container">
    {page.breadcrumb && <Breadcrumb items={page.breadcrumb} />}
    {page.badge && <p class="hero-badge">{page.badge}</p>}
    <div class="industry-hero-copy">
      <h1>
        {page.headline}
        {page.highlight && <> <span class="gradient-text">{page.highlight}</span></>}
      </h1>
      <p class="lede">{page.subhead}</p>
    </div>
  </div>
</section>

{
  page.sections.map((section) => {
    if (section.type === 'split') {
      return (
        <section class="section">
          <div class="container split-layout">
            <div><h2>{section.title}</h2></div>
            <div class="prose-block">
              {section.paragraphs.map((p) => <p>{p}</p>)}
            </div>
          </div>
        </section>
      );
    }

    if (section.type === 'stats') {
      return (
        <section class="section">
          <div class="container">
            <div class="section-header">
              <h2>{section.title}</h2>
              {section.subtitle && <p class="section-copy">{section.subtitle}</p>}
            </div>
            <dl class="market-stat-grid">
              {section.items.map((item) => (
                <div class="market-stat">
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                  {item.source && <p class="market-stat-source">{item.source}</p>}
                </div>
              ))}
            </dl>
          </div>
        </section>
      );
    }

    if (section.type === 'grid') {
      return (
        <section class="section section--muted">
          <div class="container">
            <div class="section-header">
              <h2>{section.title}</h2>
              {section.subtitle && <p class="section-copy">{section.subtitle}</p>}
            </div>
            <div class="story-grid">
              {section.items.map((item) => {
                const iconName = item.icon ?? iconForTitle(item.title);
                const isBrand = brandLogos.has(iconName);
                return (
                <article class="story-card">
                  <div class:list={['story-card-visual', isBrand && 'story-card-visual--brand']} aria-hidden="true">
                    {isBrand ? (
                      <BrandLogo name={iconName as 'aws' | 'azure' | 'gcp' | 'microsoft'} size="lg" />
                    ) : (
                      <Icon name={iconName} size={40} />
                    )}
                  </div>
                  <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
                  <p>{item.body}</p>
                  {item.href && <a class="story-card-link" href={item.href}>Learn more →</a>}
                </article>
                );
              })}
            </div>
          </div>
        </section>
      );
    }

    if (section.type === 'numbered') {
      return (
        <section class="section">
          <div class="container">
            <div class="section-header">
              <h2>{section.title}</h2>
              {section.subtitle && <p class="section-copy">{section.subtitle}</p>}
            </div>
            <ol class="capability-grid">
              {section.items.map((item) => (
                <li class="capability-card">
                  <div class="capability-head">
                    <span class="capability-num" aria-hidden="true">{item.num}</span>
                    <span class="capability-icon" aria-hidden="true">
                      <Icon name={item.icon ?? iconForTitle(item.title)} size={22} />
                    </span>
                  </div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>
      );
    }

    return (
      <section class="section">
        <div class="container">
          <div class="cta-band cta-band--industry">
            <div class="cta-band-inner">
              <div class="cta-band-copy">
                <h2>{section.title}</h2>
                <p class="muted">{section.body}</p>
              </div>
              <div class="cta-band-actions">
                {(() => {
                  const primary =
                    site.appEnabled || !isAppHref(section.primary.href)
                      ? section.primary
                      : { label: 'Contact sales', href: '/contact' };
                  const secondary =
                    section.secondary && (site.appEnabled || !isAppHref(section.secondary.href))
                      ? section.secondary
                      : undefined;
                  return (
                    <>
                      <a class="btn btn-primary" href={primary.href}>{primary.label}</a>
                      {secondary && (
                        <a class="btn btn-secondary" href={secondary.href}>{secondary.label}</a>
                      )}
                    </>
                  );
                })()}
              </div>
            </div>
          </div>
        </div>
      </section>
    );
  })
}
