---
import { site } from '../config';
import { onboardingQuestions } from '../content/onboarding';

const email = import.meta.env.PUBLIC_CONTACT_EMAIL || site.email;
---

<form class="form panel onboarding-form" id="onboarding-form" data-onboarding data-contact-email={email} method="post" action="/contact" novalidate>
  <h3>Start with a plan</h3>
  <p class="muted onboarding-lead">
    Five questions. We recommend a service and a cloud path — we do not ask you to pick a server or expose your network.
  </p>
  <p class="form-req-note"><span class="req" aria-hidden="true">*</span> Required</p>

  <label for="contact-name">
    <span class="field-caption">Full name <span class="req" aria-hidden="true">*</span></span>
    <input
      id="contact-name"
      type="text"
      name="name"
      autocomplete="name"
      required
      minlength="2"
      maxlength="80"
      aria-required="true"
      aria-describedby="contact-name-error"
    />
    <span class="field-error" id="contact-name-error" role="alert"></span>
  </label>
  <label for="contact-email">
    <span class="field-caption">Work email <span class="req" aria-hidden="true">*</span></span>
    <input
      id="contact-email"
      type="email"
      name="email"
      autocomplete="email"
      required
      maxlength="120"
      aria-required="true"
      aria-describedby="contact-email-error"
    />
    <span class="field-error" id="contact-email-error" role="alert"></span>
  </label>
  <label for="contact-company">
    <span class="field-caption">Company <span class="optional">optional</span></span>
    <input id="contact-company" type="text" name="company" autocomplete="organization" maxlength="120" />
  </label>

  {
    onboardingQuestions.map((q) => (
      <fieldset class="onboarding-fieldset">
        <legend>
          {q.label} <span class="optional">optional</span>
        </legend>
        <p class="onboarding-hint">{q.hint}</p>
        <select name={q.id} data-onboarding-field>
          <option value="">Select…</option>
          {q.options.map((opt) => (
            <option value={opt.value}>{opt.label}</option>
          ))}
        </select>
      </fieldset>
    ))
  }

  <label for="contact-notes">
    <span class="field-caption">Anything else we should know? <span class="optional">optional</span></span>
    <textarea id="contact-notes" name="notes" rows="4" maxlength="800"></textarea>
  </label>

  <input type="hidden" name="recommended_service" data-onboarding-service />
  <input type="hidden" name="recommended_cloud" data-onboarding-cloud />
  <input type="hidden" name="recommended_summary" data-onboarding-summary />

  <aside class="onboarding-plan" data-onboarding-plan hidden>
    <p class="label-sm">Recommended path</p>
    <h4 data-onboarding-plan-service></h4>
    <p data-onboarding-plan-cloud></p>
    <p class="muted" data-onboarding-plan-cloud-body></p>
    <p data-onboarding-plan-engagement></p>
    <p class="onboarding-plan-note">
      Production stays in <strong>your</strong> AWS, Azure, or GCP account (or private network). We connect with least privilege — not a copy of your estate.
    </p>
  </aside>

  <button class="btn btn-primary btn-lg" type="submit">Send request</button>
  <p class="muted onboarding-status" data-onboarding-status hidden></p>
  <p class="muted onboarding-fallback">
    Or email <a href={`mailto:${email}`}>{email}</a> if the form is blocked.
  </p>
</form>

<script>
  import { recommendPlan } from '../content/onboarding';
  import { inspectEmail } from '../../shared/email-guard';

  type VisitorFn = () => Record<string, unknown>;

  const form = document.querySelector<HTMLFormElement>('[data-onboarding]');
  const plan = document.querySelector<HTMLElement>('[data-onboarding-plan]');
  if (!form || !plan) {
    /* no-op when this island is not on the page */
  } else {
    const serviceEl = plan.querySelector('[data-onboarding-plan-service]');
    const cloudEl = plan.querySelector('[data-onboarding-plan-cloud]');
    const cloudBodyEl = plan.querySelector('[data-onboarding-plan-cloud-body]');
    const engagementEl = plan.querySelector('[data-onboarding-plan-engagement]');
    const serviceInput = form.querySelector<HTMLInputElement>('[data-onboarding-service]');
    const cloudInput = form.querySelector<HTMLInputElement>('[data-onboarding-cloud]');
    const summaryInput = form.querySelector<HTMLInputElement>('[data-onboarding-summary]');

    function visitorMeta() {
      const fn = (window as Window & { dynasaiVisitor?: VisitorFn }).dynasaiVisitor;
      return typeof fn === 'function' ? fn() : {};
    }

    function fieldErrorEl(field: HTMLElement) {
      return document.getElementById(`${field.id}-error`);
    }

    function clearField(field: HTMLInputElement) {
      field.setCustomValidity('');
      field.classList.remove('is-invalid');
      field.removeAttribute('aria-invalid');
      field.closest('label')?.classList.remove('is-invalid');
      const err = fieldErrorEl(field);
      if (err) err.textContent = '';
    }

    function markInvalid(field: HTMLInputElement, message: string) {
      field.setCustomValidity(message);
      field.classList.add('is-invalid');
      field.setAttribute('aria-invalid', 'true');
      field.closest('label')?.classList.add('is-invalid');
      const err = fieldErrorEl(field);
      if (err) err.textContent = message;
    }

    function validateForm() {
      const name = form!.elements.namedItem('name') as HTMLInputElement;
      const email = form!.elements.namedItem('email') as HTMLInputElement;
      clearField(name);
      clearField(email);
      if (name.value.trim().length < 2) {
        markInvalid(name, 'Enter your full name.');
      }
      if (!email.value.trim()) {
        markInvalid(email, 'Enter your email.');
      } else {
        const mailbox = inspectEmail(email.value);
        if (!mailbox.ok) markInvalid(email, mailbox.error);
      }
      const first = form!.querySelector<HTMLInputElement>('.is-invalid');
      first?.focus();
      return !first;
    }

    function readAnswers() {
      const data = new FormData(form!);
      return {
        job: String(data.get('job') || ''),
        industry: String(data.get('industry') || ''),
        cloud: String(data.get('cloud') || ''),
        residency: String(data.get('residency') || ''),
        start: String(data.get('start') || ''),
      };
    }

    function updatePlan() {
      const answers = readAnswers();
      if (!answers.job || !answers.industry || !answers.cloud || !answers.residency || !answers.start) {
        plan!.hidden = true;
        return;
      }
      const rec = recommendPlan(answers);
      plan!.hidden = false;
      if (serviceEl) {
        serviceEl.textContent = rec.serviceTitle;
        const link = rec.serviceHref;
        serviceEl.replaceChildren();
        const a = document.createElement('a');
        a.href = link;
        a.textContent = rec.serviceTitle;
        serviceEl.append(a);
      }
      if (cloudEl) cloudEl.textContent = rec.cloudTitle;
      if (cloudBodyEl) cloudBodyEl.textContent = rec.cloudBody;
      if (engagementEl) engagementEl.textContent = rec.engagement;
      if (serviceInput) serviceInput.value = rec.serviceTitle;
      if (cloudInput) cloudInput.value = rec.cloudTitle;
      if (summaryInput) summaryInput.value = rec.summary;
    }

    form.addEventListener('change', updatePlan);
    form.addEventListener('input', (event) => {
      const target = event.target;
      if (target instanceof HTMLInputElement && target.classList.contains('is-invalid')) {
        clearField(target);
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!validateForm()) return;
      updatePlan();
      const data = new FormData(form);
      const status = form.querySelector<HTMLElement>('[data-onboarding-status]');
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (status) {
        status.hidden = false;
        status.textContent = 'Sending…';
      }
      if (submit) submit.disabled = true;
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name: data.get('name'),
            email: data.get('email'),
            company: data.get('company'),
            job: data.get('job'),
            industry: data.get('industry'),
            cloud: data.get('cloud'),
            residency: data.get('residency'),
            start: data.get('start'),
            recommended_service: data.get('recommended_service'),
            recommended_cloud: data.get('recommended_cloud'),
            notes: data.get('notes'),
            path: location.pathname,
            ...visitorMeta(),
          }),
        });
        const raw = await res.text();
        let json: { ok?: boolean; error?: string; message?: string; field?: string } = {};
        try {
          json = raw ? (JSON.parse(raw) as typeof json) : {};
        } catch {
          json = {
            ok: false,
            error:
              res.status >= 400
                ? `Could not send (${res.status}). Email hello@dynasai.ai.`
                : 'Could not send. Email hello@dynasai.ai.',
          };
        }
        if (!json.ok && json.field === 'email') {
          const emailField = form.querySelector<HTMLInputElement>('#contact-email');
          if (emailField) markInvalid(emailField, json.error || 'Enter a valid email address.');
        }
        if (status) {
          status.textContent = json.ok
            ? json.message || 'Thanks. We emailed you a confirmation. We will get back to you within 2–3 working days.'
            : json.error || 'Could not send. Email hello@dynasai.ai.';
        }
        if (json.ok) form.reset();
      } catch {
        if (status) status.textContent = 'Could not send. Email hello@dynasai.ai.';
      }
      if (submit) submit.disabled = false;
    });
  }
</script>
