---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import CompactMegaPanel from './CompactMegaPanel.astro';
import Icon from './Icon.astro';
import { site, nav, platformMegaMenu, resourcesMegaMenu, companyMegaMenu } from '../config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="container header-inner">
    <Logo />

    <nav class="nav" id="primary-nav" data-nav aria-label="Primary">
      {
        nav.map((item) =>
          'mega' in item && item.mega === 'platform' ? (
            <div class="nav-item nav-item--mega nav-item--platform" data-mega-item data-mega-id="platform">
              <button
                type="button"
                class="nav-trigger"
                data-mega-trigger
                aria-expanded="false"
                aria-controls="mega-platform"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
                <Icon name="chevron-down" size={14} class="nav-chevron" />
              </button>
            </div>
          ) : 'mega' in item && item.mega === 'resources' ? (
            <div class="nav-item nav-item--mega" data-mega-item data-mega-id="resources">
              <button
                type="button"
                class="nav-trigger"
                data-mega-trigger
                aria-expanded="false"
                aria-controls="mega-resources"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
                <Icon name="chevron-down" size={14} class="nav-chevron" />
              </button>
            </div>
          ) : 'mega' in item && item.mega === 'company' ? (
            <div class="nav-item nav-item--mega" data-mega-item data-mega-id="company">
              <button
                type="button"
                class="nav-trigger"
                data-mega-trigger
                aria-expanded="false"
                aria-controls="mega-company"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
                <Icon name="chevron-down" size={14} class="nav-chevron" />
              </button>
            </div>
          ) : (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <a class={site.appEnabled ? 'btn btn-secondary header-cta-secondary' : 'btn btn-primary'} href="/contact">Contact Sales</a>
      {site.appEnabled && (
        <a class="btn btn-primary" href={site.appUrl}>Start Building</a>
      )}
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="primary-nav" aria-label="Open menu">
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>

  <div class="mega-menu-layer" id="mega-platform" data-mega-layer="platform" data-mega-panel hidden>
    <div class="container mega-menu-layer-inner">
      <div class="mega-menu-inner mega-menu-inner--platform">
        <div class="mega-menu-main">
          <div class="mega-menu-intro">
            <h2>{platformMegaMenu.title}</h2>
            <p>{platformMegaMenu.description}</p>
          </div>
          <div class="mega-menu-grid">
            {
              platformMegaMenu.columns.map((column) => (
                <div class="mega-menu-col">
                  <h3>
                    <span class="mega-menu-icon" aria-hidden="true">
                      <Icon name={column.icon} size={14} />
                    </span>
                    {column.label}
                  </h3>
                  <ul>
                    {column.links.map((link) => (
                      <li>
                        <a href={link.href}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
        <aside class="mega-menu-featured">
          <h3>{platformMegaMenu.featured.title}</h3>
          <div class="mega-menu-visual" aria-hidden="true">
            <Icon name="workflow" size={48} class="mega-menu-visual-icon" />
          </div>
          <p>{platformMegaMenu.featured.description}</p>
          <a class="btn btn-primary btn-block" href={platformMegaMenu.featured.href}>
            {platformMegaMenu.featured.cta}
          </a>
        </aside>
      </div>
    </div>
  </div>

  <CompactMegaPanel id="resources" {...resourcesMegaMenu} />
  <CompactMegaPanel id="company" {...companyMegaMenu} />
</header>
