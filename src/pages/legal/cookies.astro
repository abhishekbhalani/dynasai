---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const title = 'Cookie Policy';
const description = 'Cookies and similar technologies used on dynasai.ai, including Google Tag Manager.';
const updated = '17 August 2026';

const sections = [
  { id: 'essential', label: 'Essential' },
  { id: 'gtm', label: 'Google Tag Manager' },
  { id: 'ga', label: 'Google Analytics' },
  { id: 'control', label: 'Control' },
];
---

<BaseLayout title={title} description={description}>
  <PageHero
    badge={`Legal · Updated ${updated}`}
    title="Cookie"
    highlight="Policy"
    description="How we use cookies and similar technologies on dynasai.ai."
  />

  <section class="section">
    <div class="container legal-layout">
      <nav class="legal-nav" aria-label="Cookie policy sections">
        <h2>On this page</h2>
        <ul>
          {sections.map(({ id, label }) => (
            <li><a href={`#${id}`}>{label}</a></li>
          ))}
        </ul>
      </nav>

      <article class="legal-content prose">
        <h2 id="essential">Essential</h2>
        <p>
          We store a <code>theme</code> preference in localStorage so light/dark mode survives a
          reload. That is not a tracking cookie.
        </p>

        <h2 id="gtm">Google Tag Manager</h2>
        <p>
          In production we load Google Tag Manager (GTM-KDPPRVV2). GTM itself is a container. Tags you
          publish inside it (Analytics, ads, heatmaps) may set cookies. Configure Consent Mode in GTM
          before enabling advertising tags.
        </p>

        <h2 id="ga">Google Analytics and first-party activity</h2>
        <p>
          Google Analytics 4 loads in production only when a <code>G-</code> measurement ID is set.
          Hits wait for performance-cookie consent. Do not paste a GTM ID into that field.
        </p>
        <p>
          With the same consent we also store first-party activity on Cloudflare (page, section, clicks,
          time on page, approximate location/ISP from Cloudflare, hashed IP). This powers the internal
          admin activity view. We cannot see Wi‑Fi SSIDs, exact GPS, or personal identity unless you
          type it into a form.
        </p>

        <h2 id="control">Control</h2>
        <p>
          Use the banner on first visit, or
          <a href="#cookie-settings" data-open-cookie-settings>open cookie settings</a>
          anytime. You can also block cookies in your browser. Do-not-track signals are not universally honored by third-party tags.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
