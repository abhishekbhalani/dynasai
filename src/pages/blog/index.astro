---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = 'Resources & Insights';
const description = 'Notes on AI delivery, developer platforms, and how DynasAI ships production systems.';

const [featured, ...rest] = posts;
---

<BaseLayout title={title} description={description}>
  <PageHero
    badge="Resources"
    title="Resources &"
    highlight="Insights"
    description="Long-form writing for operators and builders. Indexed, canonical, and available as RSS."
  />

  {
    featured && (
      <section class="section">
        <div class="container">
          <p class="label-sm muted">Featured</p>
          <article class="blog-feature">
            <time datetime={featured.data.pubDate.toISOString()} class="muted">
              {featured.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
            <h2>
              <a href={`/blog/${featured.id}`}>{featured.data.title}</a>
            </h2>
            <p class="muted">{featured.data.description}</p>
            <a class="btn btn-secondary" href={`/blog/${featured.id}`}>Read article</a>
          </article>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <h2>Latest articles</h2>
      <div class="card-grid" style="margin-top: 24px;">
        {
          rest.map((post) => (
            <article class="card">
              <p class="muted">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
              </p>
              <h3>
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="muted">{post.data.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container newsletter-band">
      <h3>Stay in the loop</h3>
      <p>Product updates, delivery notes, and platform releases. No spam.</p>
      <a class="btn btn-secondary" href="/contact">Subscribe via contact</a>
    </div>
  </section>
</BaseLayout>
