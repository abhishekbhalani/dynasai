---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About';
const description =
  'DynasAI is an AI delivery studio and developer platform. We help operators ship systems and give builders APIs to extend them.';
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="container prose">
      <p class="kicker">About</p>
      <h1>A studio that also ships a platform</h1>
      <p class="lede">
        DynasAI exists for two audiences that usually get split across vendors: operators who need
        AI in production, and developers who need a durable API and workspace.
      </p>
      <p>
        The public site is built as a static, search-first surface on Cloudflare Workers. Customer
        product experiences — demos, login, billing, keys — will live on
        <a href="https://app.dynasai.ai">app.dynasai.ai</a> as a separate app.
      </p>
      <p>
        We keep that split on purpose: marketing pages stay cacheable and indexable; the app can
        iterate without dragging SEO with it.
      </p>
    </div>
  </section>
</BaseLayout>
