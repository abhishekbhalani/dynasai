---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { iconForTitle } from '../lib/icon-map';

const title = 'Solutions Overview';
const description =
  'Transform operations with intelligent automation. Function-specific capabilities for customer ops, finance, HR, and supply chain.';

const capabilities = [
  ['Customer Operations', 'Resolve tickets, route requests, and automate service workflows with governed agents.'],
  ['Finance & Accounting', 'Accelerate reconciliation, reporting, and controls with document intelligence.'],
  ['Human Resources', 'Streamline onboarding, policy answers, and workforce operations.'],
  ['Supply Chain', 'Coordinate vendors, inventory signals, and exception handling at scale.'],
];
---

<BaseLayout title={title} description={description}>
  <PageHero
    badge="Platform"
    title="Transform Operations with"
    highlight="Intelligent Automation"
    description={description}
  />

  <section class="section">
    <div class="container">
      <h2>Function-Specific Capabilities</h2>
      <div class="feature-grid" style="margin-top: 24px;">
        {capabilities.map(([title, body]) => (
          <article class="info-card">
            <div class="icon-box" aria-hidden="true">
              <Icon name={iconForTitle(title)} size={22} />
            </div>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header section-header--center">
        <h2>Platform Layers</h2>
        <p class="section-copy section-copy--center">Build, connect, understand, and operate from one system.</p>
      </div>
      <div class="bento-grid">
        <article class="bento-card" id="build">
          <div class="bento-icon" aria-hidden="true"><Icon name="hammer" size={22} /></div>
          <h3>Build</h3>
          <p>AI automation, agents, workflow orchestration, and the agent builder.</p>
        </article>
        <article class="bento-card" id="connect">
          <div class="bento-icon" aria-hidden="true"><Icon name="plug" size={22} /></div>
          <h3>Connect</h3>
          <p>Integrations, APIs, webhooks, tools, and enterprise apps.</p>
        </article>
        <article class="bento-card" id="understand">
          <div class="bento-icon" aria-hidden="true"><Icon name="database" size={22} /></div>
          <h3><a href="/platform/data-processing">Understand</a></h3>
          <p>Data processing, RAG, document intelligence, enterprise search, and memory.</p>
        </article>
        <article class="bento-card" id="operate">
          <div class="bento-icon" aria-hidden="true"><Icon name="shield" size={22} /></div>
          <h3><a href="/platform/governance">Operate</a></h3>
          <p>Observability, evaluation, GDPR, EU AI Act, and security controls.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container">
      <div class="cta-band">
        <div class="cta-band-inner">
          <div class="cta-band-copy">
            <h2>See DynasAI in action</h2>
            <p class="muted">Explore platform infrastructure, docs, and a live demo workspace.</p>
          </div>
          <div class="cta-band-actions">
            <a class="btn btn-primary" href="/docs">Platform overview</a>
            <a class="btn btn-secondary" href="/contact">Book a demo</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
