---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config';

const title = 'AI systems for operators. APIs for builders.';
const description = site.description;
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Agency delivery · Developer platform</p>
        <h1>{site.tagline}</h1>
        <p class="lede">
          DynasAI helps companies design, ship, and run production AI — then gives your team a
          workspace and APIs to keep building. Marketing lives here. Product lives on
          <a href={site.appUrl}>app.dynasai.ai</a>.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/contact">Start a project</a>
          <a class="btn btn-secondary" href="/docs">Explore the API</a>
        </div>
        <div class="stat-row">
          <div class="stat">
            <b>2 tracks</b>
            <span class="muted">Services + platform</span>
          </div>
          <div class="stat">
            <b>Static-first</b>
            <span class="muted">Cloudflare Workers</span>
          </div>
          <div class="stat">
            <b>SEO-ready</b>
            <span class="muted">Sitemap, schema, GTM</span>
          </div>
        </div>
      </div>
      <aside class="hero-panel" aria-label="What we ship">
        <p class="kicker">What you get</p>
        <h2>From brief to production workspace</h2>
        <ul class="list">
          <li>AI strategy, agents, and integration for operators</li>
          <li>APIs, SDKs, and docs for engineering teams</li>
          <li>A customer workspace on the app subdomain</li>
          <li>Analytics and search foundations from day one</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="tracks-heading">
    <div class="container">
      <div class="section-header">
        <p class="kicker">Two ways to work with us</p>
        <h2 id="tracks-heading">Studio for delivery. Platform for builders.</h2>
      </div>
      <div class="split">
        <article class="card">
          <p class="kicker">Services</p>
          <h3>AI delivery studio</h3>
          <p class="muted">
            Discovery, custom agents, data integration, and operated systems for teams that need
            outcomes — not another prototype.
          </p>
          <p><a href="/features">See services</a></p>
        </article>
        <article class="card">
          <p class="kicker">Platform</p>
          <h3>Developer tools &amp; API</h3>
          <p class="muted">
            Typed APIs, evals, and a workspace at app.dynasai.ai so your product team can ship
            against a stable contract.
          </p>
          <p><a href="/docs">Read docs</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="features-heading">
    <div class="container">
      <div class="section-header">
        <p class="kicker">Product</p>
        <h2 id="features-heading">Built for search, speed, and a later app split</h2>
        <p class="section-copy">
          This site is a static Astro build on Cloudflare Workers. The demo and customer app will
          live on a separate Workers project bound to the app subdomain.
        </p>
      </div>
      <div class="card-grid">
        <article class="card">
          <h3>Search-first pages</h3>
          <p class="muted">Canonical URLs, Open Graph, JSON-LD, sitemap, robots, and RSS.</p>
        </article>
        <article class="card">
          <h3>Tag management</h3>
          <p class="muted">Google Tag Manager is wired for production. GA4 can load from GTM.</p>
        </article>
        <article class="card">
          <h3>Light and dark</h3>
          <p class="muted">Theme tokens in CSS variables, WCAG AA contrast, system-aware default.</p>
        </article>
      </div>
    </div>
  </section>

  <div class="container">
    <CtaBand
      title="Tell us what you want to ship"
      body="A delivery engagement, an API workspace, or both. We’ll map the shortest path."
    />
  </div>
</BaseLayout>
