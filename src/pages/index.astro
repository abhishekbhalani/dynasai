---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';

const title = 'Turn Enterprise Complexity Into Intelligent Action';
const description = site.description;

const lifecycle = [
  {
    title: 'Discover',
    body: 'Identify automation bottlenecks across your enterprise architecture. Our analysis engines map complex operational inefficiencies and pinpoint high-ROI agentic opportunities.',
    icon: '◎',
  },
  {
    title: 'Design',
    body: 'Architect intelligent workflows on our visual canvas. Connect data sources, assign AI agent capabilities, and define complex logic gates without extensive code.',
    icon: '◇',
  },
  {
    title: 'Deploy',
    body: 'Push workflows to production instantly. DynasAI handles infrastructure scaling, version control, and secure environment management for agentic solutions.',
    icon: '↑',
  },
  {
    title: 'Optimize',
    body: 'Monitor performance in real-time. Gain actionable insights into agent decisions, token usage, and execution speed to refine your intelligence layer.',
    icon: '≋',
  },
];

const trustItems = [
  'Cloud Infrastructure',
  'Data Warehouses',
  'API Gateways',
  'Enterprise Security',
];
---

<BaseLayout title={title} description={description}>
  <section class="hero-enterprise bg-grid-pattern">
    <div class="container">
      <p class="hero-badge">Enterprise-Ready Agentic Automation</p>
      <h1>
        Turn Enterprise Complexity Into <span class="gradient-text">Intelligent Action</span>
      </h1>
      <p class="lede">{description}</p>
      <div class="hero-actions hero-actions--center">
        <a class="btn btn-primary btn-lg" href="/contact">Start Building</a>
        <a class="btn btn-secondary btn-lg" href="/features">View Platform</a>
      </div>

      <div class="orchestration bg-grid-pattern" aria-label="Orchestration visualization">
        <div class="orchestration-lines" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="orchestration-inner">
          <div class="orchestration-col">
            <div class="orchestration-node">
              <span aria-hidden="true">▣</span>
              <strong>Enterprise Data</strong>
            </div>
            <div class="orchestration-node">
              <span aria-hidden="true">◉</span>
              <strong>AI Agents</strong>
            </div>
            <div class="orchestration-node">
              <span aria-hidden="true">◍</span>
              <strong>People</strong>
            </div>
          </div>
          <div class="orchestration-hub" aria-hidden="true">
            <span>◎</span>
            <span>Intelligence Layer</span>
          </div>
          <div class="orchestration-col orchestration-col--center">
            <div class="orchestration-node orchestration-node--large">
              <span aria-hidden="true">↗</span>
              <strong>Business Outcomes</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-bar" aria-label="Trusted ecosystem">
    <div class="container">
      <p class="label-sm muted">Trusted Ecosystem</p>
      <div class="trust-items">
        {trustItems.map((item) => (
          <div class="trust-item">
            <span aria-hidden="true">●</span>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="lifecycle-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <h2 id="lifecycle-heading">The Automation Lifecycle</h2>
        <p class="section-copy section-copy--center">
          A comprehensive toolkit to transform manual processes into sophisticated, agentic workflows.
        </p>
      </div>
      <div class="bento-grid">
        {lifecycle.map((item) => (
          <article class="bento-card">
            <div class="bento-icon" aria-hidden="true">{item.icon}</div>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
            <div class="bento-visual" aria-hidden="true">
              <div class="bento-visual-bar"></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
