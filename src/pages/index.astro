---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';
import { servicePillars, differentiators } from '../content/site-content';

const title = 'Turn Enterprise Complexity Into Intelligent Action';
const description = site.description;

const lifecycle = [
  {
    title: 'Discover',
    body: 'Map operational bottlenecks, data constraints, and high-ROI automation opportunities across your enterprise.',
    icon: '◎',
  },
  {
    title: 'Design',
    body: 'Architect agent workflows, tool access, and human-in-the-loop controls on a governed visual canvas.',
    icon: '◇',
  },
  {
    title: 'Deploy',
    body: 'Ship to production with versioned agents, secure integrations, and environment-aware rollout.',
    icon: '↑',
  },
  {
    title: 'Operate',
    body: 'Monitor traces, eval scores, and drift — iterate continuously with AgentOps, not one-off pilots.',
    icon: '≋',
  },
];

const trustItems = ['Cloud platforms', 'Data warehouses', 'Enterprise identity', 'API ecosystems'];
---

<BaseLayout title={title} description={description}>
  <section class="hero-enterprise bg-grid-pattern">
    <div class="container">
      <p class="hero-badge">AI Delivery Studio + Developer Platform</p>
      <h1>
        Turn Enterprise Complexity Into <span class="gradient-text">Intelligent Action</span>
      </h1>
      <p class="lede">
        DynasAI combines a governed agent platform with delivery expertise — so you can build yourself,
        implement with our team, or run both in parallel on the same stack.
      </p>
      <div class="hero-actions hero-actions--center">
        <a class="btn btn-primary btn-lg" href={site.appUrl}>Start Building</a>
        <a class="btn btn-secondary btn-lg" href="/platform/toolkit">Explore Toolkit</a>
      </div>

      <div class="orchestration bg-grid-pattern" aria-label="Orchestration visualization">
        <div class="orchestration-lines" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="orchestration-inner">
          <div class="orchestration-col">
            <div class="orchestration-node">
              <span aria-hidden="true">▣</span>
              <strong>Enterprise Data</strong>
            </div>
            <div class="orchestration-node">
              <span aria-hidden="true">◉</span>
              <strong>AI Agents</strong>
            </div>
            <div class="orchestration-node">
              <span aria-hidden="true">◍</span>
              <strong>People</strong>
            </div>
          </div>
          <div class="orchestration-hub" aria-hidden="true">
            <span>◎</span>
            <span>Intelligence Layer</span>
          </div>
          <div class="orchestration-col orchestration-col--center">
            <div class="orchestration-node orchestration-node--large">
              <span aria-hidden="true">↗</span>
              <strong>Business Outcomes</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-bar" aria-label="Trusted ecosystem">
    <div class="container">
      <p class="label-sm muted">Built for the modern enterprise stack</p>
      <div class="trust-items">
        {trustItems.map((item) => (
          <div class="trust-item">
            <span aria-hidden="true">●</span>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <h2 id="services-heading">Transform data into intelligent action</h2>
        <p class="section-copy section-copy--center">
          Four delivery pillars — from strategy through operated production — on one platform.
        </p>
      </div>
      <div class="card-grid">
        {servicePillars.map((pillar) => (
          <article class="card">
            <h3><a href={pillar.href}>{pillar.title}</a></h3>
            <p class="muted">{pillar.summary}</p>
            <ul class="list-compact">
              {pillar.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="lifecycle-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <h2 id="lifecycle-heading">The agent automation lifecycle</h2>
        <p class="section-copy section-copy--center">
          A repeatable path from discovery to continuous operation — supported by the Dynas Toolkit and workspace.
        </p>
      </div>
      <div class="bento-grid">
        {lifecycle.map((item) => (
          <article class="bento-card">
            <div class="bento-icon" aria-hidden="true">{item.icon}</div>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
            <div class="bento-visual" aria-hidden="true">
              <div class="bento-visual-bar"></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container">
      <div class="cta-band">
        <div class="cta-band-inner">
          <div class="cta-band-copy">
            <h2>Own your AI journey with modular accelerators</h2>
            <p class="muted">
              Dynas Toolkit modules — templates, evals, deployment pipelines — speed delivery whether you self-serve or work with our studio.
            </p>
          </div>
          <div class="cta-band-actions">
            <a class="btn btn-primary" href="/platform/toolkit">View toolkit</a>
            <a class="btn btn-secondary" href="/contact">Talk to an expert</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
