---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import { site } from '../config';
import {
  servicePillars,
  cloudProviders,
  platformModel,
  dataProcessing,
  complianceStandards,
} from '../content/site-content';

const title = 'Turn Enterprise Complexity Into Intelligent Action';
const description = site.description;

const lifecycle = [
  {
    title: 'Discover',
    body: 'Map data sources, cloud options, compliance needs, and high-ROI automation opportunities.',
    icon: '◎',
  },
  {
    title: 'Design',
    body: 'Architect agents, data pipelines, and human-in-the-loop controls on your chosen cloud backend.',
    icon: '◇',
  },
  {
    title: 'Deploy',
    body: 'Ship to AWS, Azure, or GCP with secure integrations, eval gates, and environment-aware rollout.',
    icon: '↑',
  },
  {
    title: 'Operate',
    body: 'Monitor traces, data quality, and drift — iterate with AgentOps and compliance cadence.',
    icon: '≋',
  },
];
---

<BaseLayout title={title} description={description}>
  <HeroBanner />

  <section class="trust-bar" aria-label="Supported cloud platforms">
    <div class="container">
      <p class="label-sm muted">Backend services on the clouds you already use</p>
      <div class="cloud-trust-grid">
        {cloudProviders.map((provider) => (
          <div class="cloud-trust-item">
            <strong>{provider.short}</strong>
            <span>{provider.body}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="platform-model-heading">
    <div class="container split-layout">
      <div>
        <h2 id="platform-model-heading">{platformModel.title}</h2>
        <p class="section-copy">{platformModel.subtitle}</p>
      </div>
      <div class="platform-model-grid">
        <article class="info-card">
          <h3>DynasAI front layer</h3>
          <p class="muted">What your teams interact with every day.</p>
          <ul class="list-compact">
            {platformModel.frontLayer.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
        <article class="info-card">
          <h3>Your cloud backend</h3>
          <p class="muted">Where compute, storage, and models run — your choice.</p>
          <ul class="list-compact">
            {platformModel.backendLayer.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--muted" aria-labelledby="data-processing-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <h2 id="data-processing-heading">{dataProcessing.title}</h2>
        <p class="section-copy section-copy--center">{dataProcessing.body}</p>
      </div>
      <div class="feature-grid feature-grid--4">
        {dataProcessing.steps.map((step) => (
          <article class="info-card">
            <div class="icon-box">{step.title.slice(0, 1)}</div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <h2 id="services-heading">Enterprise AI services for the modern era</h2>
        <p class="section-copy section-copy--center">
          Strategy, data processing, automation, and compliance — delivered on AWS, Azure, or GCP.
        </p>
      </div>
      <div class="card-grid">
        {servicePillars.map((pillar) => (
          <article class="card">
            <h3><a href={pillar.href}>{pillar.title}</a></h3>
            <p class="muted">{pillar.summary}</p>
            <ul class="list-compact">
              {pillar.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="compliance-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="compliance-heading">{complianceStandards.title}</h2>
        <p class="section-copy">{complianceStandards.body}</p>
      </div>
      <div class="feature-grid">
        {complianceStandards.items.map((item) => (
          <article class="info-card">
            <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="lifecycle-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <h2 id="lifecycle-heading">The agent automation lifecycle</h2>
        <p class="section-copy section-copy--center">
          From discovery to operated production — on your cloud, with our front layer and toolkit.
        </p>
      </div>
      <div class="bento-grid">
        {lifecycle.map((item) => (
          <article class="bento-card">
            <div class="bento-icon" aria-hidden="true">{item.icon}</div>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
            <div class="bento-visual" aria-hidden="true">
              <div class="bento-visual-bar"></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container">
      <div class="cta-band">
        <div class="cta-band-inner">
          <div class="cta-band-copy">
            <h2>Start with the right cloud and data model</h2>
            <p class="muted">
              We recommend cost-effective AWS, Azure, or GCP architectures — then deliver automation on the DynasAI front layer with full data control.
            </p>
          </div>
          <div class="cta-band-actions">
            <a class="btn btn-primary" href="/contact">Talk to an expert</a>
            <a class="btn btn-secondary" href="/partners">Cloud partners</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
