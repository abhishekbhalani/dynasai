---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import OnboardingForm from '../components/OnboardingForm.astro';
import { site } from '../config';

const title = 'Contact Sales';
const description =
  'Tell us the job to automate and where data lives. We recommend a DynasAI service and cloud path — your AWS, Azure, or GCP stays yours.';
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || site.email;
---

<BaseLayout title={title} description={description}>
  <PageHero
    badge="Contact"
    title="Start with a"
    highlight="recommended path"
    description="Five questions. We suggest a service and whether to stay on AWS, Azure, or GCP. We never ask you to expose your network on this form."
  />

  <section class="section">
    <div class="container split-layout">
      <div>
        <h2>Talk to an AI expert</h2>
        <p class="lede">
          DynasAI is the front layer. Production data and models stay in your cloud with least-privilege access — or a managed pilot if you have no cloud yet.
        </p>
        <ul class="list-compact">
          <li>We recommend the stack; we do not force a hyperscaler.</li>
          <li>EU / US residency follows the region you approve.</li>
          <li>Reply within one business day: <a href={`mailto:${email}`}>{email}</a></li>
        </ul>
        <p><a href="/platform/governance">How we handle GDPR and customer control →</a></p>
        <p><a href="/partners">AWS, Azure, and GCP backends →</a></p>
      </div>

      <OnboardingForm />
    </div>
  </section>
</BaseLayout>
