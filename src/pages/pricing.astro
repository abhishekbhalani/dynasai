---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { servicePillars } from '../content/site-content';

const title = 'Services';
const description =
  'AI strategy, agent engineering, data integration, and operated production — from advisory through AgentOps.';

const engagements = [
  {
    name: 'Discovery sprint',
    bestFor: 'Teams validating AI strategy and platform fit',
    outcome: 'Prioritized roadmap, architecture, and ROI model',
    duration: '2–4 weeks',
  },
  {
    name: 'Build program',
    bestFor: 'Shipping production agents and workflows',
    outcome: 'Live automations on DynasAI with integrations and evals',
    duration: '6–16 weeks',
  },
  {
    name: 'Operate retainer',
    bestFor: 'Teams running automation after go-live',
    outcome: 'Monitoring, iteration, drift response, and governance cadence',
    duration: 'Ongoing',
  },
];
---

<BaseLayout title={title} description={description}>
  <PageHero
    badge="Services"
    title="AI delivery,"
    highlight="end to end"
    description="Consulting engagements that run on the DynasAI platform — or standalone while you evaluate. Same stack, no throwaway pilots."
  />

  <section class="section">
    <div class="container">
      <h2>What we deliver</h2>
      <p class="section-copy">Four pillars modeled for enterprise agentic automation — aligned to how modern teams actually ship.</p>
      <div class="feature-grid" style="margin-top: 24px;">
        {servicePillars.map((pillar) => (
          <article class="info-card" id={pillar.id}>
            <h3>{pillar.title}</h3>
            <p>{pillar.summary}</p>
            <ul class="list-compact">
              {pillar.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Engagement models</h2>
      <div class="data-table-wrap" style="margin-top: 24px;">
        <table>
          <thead>
            <tr>
              <th scope="col">Engagement</th>
              <th scope="col">Best for</th>
              <th scope="col">Outcome</th>
              <th scope="col">Typical duration</th>
            </tr>
          </thead>
          <tbody>
            {engagements.map((row) => (
              <tr>
                <th scope="row">{row.name}</th>
                <td>{row.bestFor}</td>
                <td>{row.outcome}</td>
                <td>{row.duration}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted" style="margin-top: 16px;">
        Scoped per engagement. Platform access is included where applicable. <a href="/contact">Contact sales</a> for a proposal.
      </p>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container">
      <div class="cta-band">
        <div class="cta-band-inner">
          <div class="cta-band-copy">
            <h2>Platform + services on one stack</h2>
            <p class="muted">Self-serve in the workspace, or pair delivery with the Dynas Toolkit accelerators.</p>
          </div>
          <div class="cta-band-actions">
            <a class="btn btn-primary" href="/platform/toolkit">Dynas Toolkit</a>
            <a class="btn btn-secondary" href="/contact">Request a quote</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
