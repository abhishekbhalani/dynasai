---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Careers';
const description = 'Open roles at DynasAI. We hire people who can ship AI systems and developer platforms.';
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="container">
      <p class="kicker">Careers</p>
      <h1>Build the studio and the platform</h1>
      <p class="lede">
        We are a small team covering delivery, product, and developer experience. Roles below are
        placeholders until hiring opens.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="data-table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Role</th>
              <th scope="col">Team</th>
              <th scope="col">Location</th>
              <th scope="col">Type</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Founding engineer</th>
              <td>Platform</td>
              <td>Remote</td>
              <td>Full-time</td>
            </tr>
            <tr>
              <th scope="row">AI delivery lead</th>
              <td>Studio</td>
              <td>Remote / hybrid</td>
              <td>Full-time</td>
            </tr>
            <tr>
              <th scope="row">Developer experience</th>
              <td>Docs &amp; SDKs</td>
              <td>Remote</td>
              <td>Contract or full-time</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="muted">Apply via <a href="/contact">contact</a> with the role in the subject.</p>
    </div>
  </section>
</BaseLayout>
