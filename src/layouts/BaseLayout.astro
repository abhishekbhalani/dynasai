---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import ActivityTracker from '../components/ActivityTracker.astro';
import QuickContact from '../components/QuickContact.astro';
import VisitorChat from '../components/VisitorChat.astro';
import Seo from '../components/Seo.astro';
import JsonLd from '../components/JsonLd.astro';
import '../styles/visitor.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description, canonical, type, noindex, jsonLd } = Astro.props;
const isAdmin = Astro.url.pathname.startsWith('/admin');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/img/logo-mark-colored.svg" />
    <link rel="apple-touch-icon" href="/img/logo-mark-colored.svg" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var stored = localStorage.getItem('theme');
          root.setAttribute('data-theme', stored || 'light');
        } catch (e) {
          root.setAttribute('data-theme', 'light');
        }
        try {
          if (localStorage.getItem('dynasai_cookie_consent')) {
            root.setAttribute('data-cookie-ok', '1');
          } else {
            root.setAttribute('data-cookie-needed', '1');
          }
        } catch (e) {
          root.setAttribute('data-cookie-needed', '1');
        }
      })();
    </script>
    <Seo title={title} description={description} canonical={canonical} type={type} noindex={noindex} />
    <JsonLd extra={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    {!isAdmin && <CookieConsent />}
    {!isAdmin && <ActivityTracker />}
    {!isAdmin && <QuickContact />}
    {!isAdmin && <VisitorChat />}
    <script>
      const root = document.documentElement;
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });

      const nav = document.querySelector('[data-nav]');
      const toggle = document.querySelector('[data-menu-toggle]');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(Boolean(open)));
      });

      const megaItems = Array.from(document.querySelectorAll('[data-mega-item]'));
      let megaCloseTimer = 0;
      const desktop = () => window.matchMedia('(min-width: 861px)').matches;

      function panelForItem(item: Element) {
        const id = item.getAttribute('data-mega-id');
        return document.querySelector(`[data-mega-layer="${id}"]`);
      }

      function setMegaOpen(item: Element, open: boolean) {
        const trigger = item.querySelector('[data-mega-trigger]');
        const panel = panelForItem(item);
        item.classList.toggle('is-open', open);
        trigger?.setAttribute('aria-expanded', String(open));
        if (open) panel?.removeAttribute('hidden');
        else panel?.setAttribute('hidden', '');
      }

      function closeMegaMenus(except?: Element | null) {
        window.clearTimeout(megaCloseTimer);
        megaItems.forEach((item) => {
          if (except && item === except) return;
          setMegaOpen(item, false);
        });
      }

      function scheduleMegaClose() {
        window.clearTimeout(megaCloseTimer);
        megaCloseTimer = window.setTimeout(() => closeMegaMenus(), 140);
      }

      function cancelMegaClose() {
        window.clearTimeout(megaCloseTimer);
      }

      function bindMegaHover(targets: Element[], item: Element) {
        targets.forEach((target) => {
          target.addEventListener('mouseenter', () => {
            if (!desktop()) return;
            cancelMegaClose();
            closeMegaMenus(item);
            setMegaOpen(item, true);
          });
          target.addEventListener('mouseleave', () => {
            if (!desktop()) return;
            scheduleMegaClose();
          });
        });
      }

      megaItems.forEach((item) => {
        const trigger = item.querySelector('[data-mega-trigger]');
        const panel = panelForItem(item);
        if (!trigger || !panel) return;

        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          const willOpen = !item.classList.contains('is-open');
          closeMegaMenus(willOpen ? item : null);
          setMegaOpen(item, willOpen);
        });

        bindMegaHover([trigger, panel], item);
      });

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (!target.closest('[data-mega-item]') && !target.closest('[data-mega-layer]')) closeMegaMenus();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMegaMenus();
      });
    </script>
  </body>
</html>
